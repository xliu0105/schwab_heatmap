{
  "name": "schwab-heatmap",
  "version": "0.1.0",
  "description": "Personal stock heatmap desktop app powered by the Schwab Trader API",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "universes": "tsx --tsconfig tsconfig.node.json scripts/build-universes.ts",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --mac",
    "install-app": "npm run dist && node scripts/install-app.mjs"
  },
  "build": {
    "appId": "local.schwab.heatmap",
    "productName": "Schwab Heatmap",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/universes",
        "to": "universes"
      },
      {
        "from": ".",
        "to": ".",
        "filter": [
          "cloud.config.json"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.finance",
      "identity": null
    }
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.8",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
